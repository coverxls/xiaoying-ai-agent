# DeepSeek / OpenAI-compatible endpoint.
# Copy this file to .env and fill in your own key. Never commit .env.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Optional: read refs.DEEPSEEK_API_KEY from a local YAML credentials file.
# This is only for local runs; reviewers can use LLM_API_KEY instead.
# DSH_CREDENTIALS_FILE=C:\path\to\.credentials.yaml
